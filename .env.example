# ============================================================================
#  ram — Random Agents Memories : markdown-vault-mcp deployment (TEMPLATE)
#  Copy to .env and fill in the secrets. .env is gitignored; this file is not.
# ============================================================================

# --- Core vault ---
MARKDOWN_VAULT_MCP_SOURCE_DIR=/vault
MARKDOWN_VAULT_MCP_READ_ONLY=false
MARKDOWN_VAULT_MCP_INDEX_PATH=/data/index.db
MARKDOWN_VAULT_MCP_EMBEDDINGS_PATH=/data/embeddings.npy
MARKDOWN_VAULT_MCP_STATE_PATH=/data/state.json
MARKDOWN_VAULT_MCP_KV_STORE_URL=file:///data/kv
MARKDOWN_VAULT_MCP_EXCLUDE=.obsidian/**,.trash/**,.git/**
MARKDOWN_VAULT_MCP_BASE_URL=https://<MCP_DOMAIN>
MARKDOWN_VAULT_MCP_SERVER_NAME=ram-brain

# --- Embeddings: local FastEmbed ---
MARKDOWN_VAULT_MCP_EMBEDDING_PROVIDER=fastembed

# --- Auth: single shared bearer token ---
# Generate with: openssl rand -hex 32
# TRANSITIONAL: kept for headless agents while OAuth is verified; removed after.
MARKDOWN_VAULT_MCP_BEARER_TOKEN=REPLACE_WITH_openssl_rand_hex_32

# --- Auth: OAuth 2.1 via Authelia (OIDC / oidc-proxy) — multi-auth ---
# Leave AUTH_MODE unset: auto-detect enables multi-auth (bearer OR OIDC) from the
# presence of both credential types. redirect URI = BASE_URL + /auth/callback.
# CLIENT_SECRET = the *plaintext* from `authelia crypto hash generate pbkdf2`
# (the $pbkdf2-sha512$ hash of it goes into authelia/configuration.yml).
# JWT_SIGNING_KEY = stable `openssl rand -hex 32` (rotating it = OAuth kill switch).
MARKDOWN_VAULT_MCP_OIDC_CONFIG_URL=https://<AUTH_DOMAIN>/.well-known/openid-configuration
MARKDOWN_VAULT_MCP_OIDC_CLIENT_ID=ram-brain
MARKDOWN_VAULT_MCP_OIDC_CLIENT_SECRET=REPLACE_WITH_pbkdf2_plaintext
MARKDOWN_VAULT_MCP_OIDC_JWT_SIGNING_KEY=REPLACE_WITH_openssl_rand_hex_32
MARKDOWN_VAULT_MCP_OIDC_REQUIRED_SCOPES=openid,email

# --- Git: managed mode, read-write (GitHub, HTTPS + fine-grained PAT) ---
MARKDOWN_VAULT_MCP_GIT_REPO_URL=https://github.com/<owner>/<vault-repo>.git
MARKDOWN_VAULT_MCP_GIT_USERNAME=x-access-token
# Fine-grained PAT scoped to the vault repo, Contents: Read and write
MARKDOWN_VAULT_MCP_GIT_TOKEN=github_pat_REPLACE_ME

# Committer identity — MANDATORY in Docker
MARKDOWN_VAULT_MCP_GIT_COMMIT_NAME=ram-brain
MARKDOWN_VAULT_MCP_GIT_COMMIT_EMAIL=brain@<MCP_DOMAIN>

# Sync timing
MARKDOWN_VAULT_MCP_GIT_PULL_INTERVAL_S=60
MARKDOWN_VAULT_MCP_GIT_PUSH_DELAY_S=10
MARKDOWN_VAULT_MCP_GIT_LFS=true

# --- Cloudflare Tunnel ---
# Ingress lives in cloudflared/config.yml; credentials stay inline here.
# Tunnel UUID (from `cloudflared tunnel create`). Passed to `cloudflared run <ID>`.
CF_TUNNEL_ID=REPLACE_WITH_TUNNEL_UUID
# Full contents of the tunnel credentials JSON, on ONE line. Get it from
# ~/.cloudflared/<TUNNEL_ID>.json after `cloudflared tunnel create`, e.g.:
#   python3 -c "import json;print('TUNNEL_CRED_CONTENTS='+json.dumps(json.load(open('<ID>.json'),),separators=(',',':')))"
TUNNEL_CRED_CONTENTS={"AccountTag":"...","TunnelSecret":"...","TunnelID":"...","Endpoint":""}
