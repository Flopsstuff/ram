# --- Internal notes (not for the repo) ---
plan.md

# --- Secrets / environment ---
# NEVER commit: bearer token, git PAT, tunnel token live here
.env
.env.*
!.env.example
*.secret
secrets/

# --- Cloudflare Tunnel ---
# The tunnel is configured from .env alone (CF_TUNNEL_ID, TUNNEL_CRED_CONTENTS).
# cloudflared/ is where `cloudflared tunnel create` output tends to be kept,
# and an ingress file from before the single hostname may still be there;
# *.pem guards any stray tunnel cert/key.
cloudflared/
*.pem

# --- Authelia (OIDC IdP) ---
# Real configuration.yml / users_database.yml hold secrets + real hostnames +
# the JWKS private key → gitignored; only the .example templates are committed.
# On the CD runner both are materialized from AUTHELIA_CONFIG / AUTHELIA_USERS.
authelia/*
!authelia/configuration.yml.example
!authelia/users_database.yml.example

# --- Docker compose local overrides ---
docker-compose.override.yml
compose.override.yml

# --- Local vault / data (if ever bind-mounted instead of named volumes) ---
vault/
data/

# --- Desktop .mcpb bundle (whole workspace + built artifact) ---
desktop/
*.mcpb

# --- Python bytecode cache (left by running or checking the scripts) ---
__pycache__/
*.pyc

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/
