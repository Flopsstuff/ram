# wiki-proxy: puts Authelia's login in front of SilverBullet.
#
# cloudflared → this proxy (plain HTTP inside the compose network) → wiki.
# Every request is first checked with Authelia's forward-auth endpoint: a
# logged-in session passes through, anything else is redirected to the Authelia
# portal. The session cookie is issued for the parent domain, so one login
# covers both the portal and the wiki. The hostname lives only in
# cloudflared/config.yml; this file matches any host.
{
	auto_https off
	admin off
}

:80 {
	# Public, no login: static files only, nothing from the vault.
	# - Our favicon set (wiki/icons), at the paths SilverBullet's page and web
	#   manifest point to, in place of SilverBullet's own.
	# - SilverBullet's service worker script. Browsers refuse to register a
	#   service worker whose script answers with a redirect, and the
	#   registration request reached Authelia without a usable session, so it
	#   got the login redirect and SilverBullet lost its offline cache. The
	#   script is SilverBullet's own client code; every request it makes for
	#   notes still goes through the login below.
	@icons path /.client/favicon.svg /.client/favicon-96x96.png /.client/favicon.ico /.client/apple-touch-icon.png /.client/logo-dock.png
	handle @icons {
		root * /srv/icons
		uri strip_prefix /.client
		file_server
	}

	handle /service_worker.js {
		reverse_proxy wiki:3000
	}

	# Everything else: Authelia first, then SilverBullet.
	handle {
		forward_auth authelia:9091 {
			uri /api/authz/forward-auth
			# TLS ends at Cloudflare's edge, so this hop is plain HTTP; Authelia
			# must still see the public scheme to build the redirect and match
			# the cookie domain.
			header_up X-Forwarded-Proto https
			copy_headers Remote-User Remote-Groups Remote-Email Remote-Name
		}
		reverse_proxy wiki:3000
	}
}
